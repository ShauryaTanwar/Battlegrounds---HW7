# Optional. Without this key the game uses the clearly labeled offline builder.
# Keep this file's real values in .env, which is ignored by Git.
OPENAI_API_KEY=
# A configurable OpenAI model that supports Responses API Structured Outputs.
OPENAI_MODEL=gpt-4o-mini
PORT=3000
# Bind only to this computer by default. Do not expose this prototype publicly.
HOST=127.0.0.1
